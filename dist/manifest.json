{
  "manifest_version": 3,
  "name": "Universal File Converter & AI Toolkit",
  "version": "1.0.0",
  "description": "Chuyển đổi file 100% Client-side: Ảnh, DOCX, PDF, JSON/CSV/XML, Markdown, AI Xóa phông & Tự động nén/đổi file khi tải về.",
  "permissions": [
    "downloads",
    "contextMenus",
    "storage",
    "clipboardRead",
    "activeTab"
  ],
  "action": {
    "default_popup": "popup/popup.html",
    "default_icon": {
      "16": "assets/icons/icon16.png",
      "32": "assets/icons/icon32.png",
      "48": "assets/icons/icon48.png",
      "128": "assets/icons/icon128.png"
    }
  },
  "options_page": "dashboard/dashboard.html",
  "background": {
    "service_worker": "background/background.js",
    "type": "module"
  },
  "icons": {
    "16": "assets/icons/icon16.png",
    "32": "assets/icons/icon32.png",
    "48": "assets/icons/icon48.png",
    "128": "assets/icons/icon128.png"
  }
}
